# 비밀 값: 예시 파일만 커밋한다
.env
.env.*
!.env.example
!.env.*.example

# 로컬 전용 대용량 데이터 (판례 벡터 DB, 원본 판례, 수집 결과)
# AI 코드가 읽는 원래 위치에 두되 git에서는 제외한다
/local-data/
/ai/data/rag_db/
/ai/crawl/*.jsonl

# 의존성과 빌드 산출물
node_modules/
.pnpm-store/
dist/
.venv/
venv/
__pycache__/
*.pyc

# OS·편집기
.DS_Store
.idea/
.vscode/

# 평가 실행 기록 (사례 서술과 LLM 요청 본문이 들어 있음)
/eval/runs/
