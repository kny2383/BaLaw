# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
# 주의: 지금 코드(cfg.py)는 작성 모델과 대화 모델이 모두 이 값 하나를 읽는다.
OPENAI_MODEL=gpt-5-mini

# 정보 추출 호출의 추론 강도 (선택). minimal, low, medium, high 중 하나.
# 비워 두면 low다. 지정하지 않던 이전 동작과 비교하려면 medium으로 둔다.
OPENAI_EXTRACT_REASONING_EFFORT=

# 판례 벡터 DB. data/rag_db/chroma.sqlite3 이 없을 때만 이 주소에서 내려받는다.
RAG_DB_URL=https://your-presigned-rag-db-url/chroma.sqlite3

# 판례 요약 캐시 (선택). 비워 두면 캐시 없이 동작한다.
REDIS_URL=
RAG_CASE_CACHE_TTL_SECONDS=604800
RAG_CASE_SUMMARY_VERSION=v1

# 대화 상태 저장소 (선택). 비워 두면 메모리에 두고 서비스가 재시작하면 세션이 사라진다.
# 값을 넣으면 PostgreSQL의 ai_checkpoint 스키마에 암호화해서 저장한다.
# docker compose로 띄우면 compose.yaml이 주소를 넣어 주므로 키만 채우면 된다.
CHECKPOINT_DB_URL=
# 체크포인트 암호화 키: base64로 적은 32바이트. 주소가 있는데 키가 없으면 서비스가 뜨지 않는다.
# 만들기: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 키를 바꾸거나 잃으면 저장된 세션은 읽을 수 없다.
CHECKPOINT_AES_KEY=
# 1로 두면 세션의 단계별 상태 기록을 지우지 않는다 (가상 사례 분석용). 기본은 최신 상태만 남긴다.
CHECKPOINT_KEEP_HISTORY=

# LLM 호출이 일시적 오류(연결, 시간 초과, 429, 5xx)로 실패했을 때 다시 시도하는 횟수 (기본 2).
OPENAI_MAX_RETRIES=

# 초안을 대화와 대조해 근거 없는 표현을 고쳐 다시 쓰는 횟수의 상한. 0이면 검증하지 않는다 (기본 1).
DRAFT_MAX_REWRITES=
# 검증이 찾은 표현을 고치기 전에 사용자에게 사실인지 묻는다 (기본 켜짐). 0으로 두면 묻지 않고 고친다.
DRAFT_CONFIRM=
# 한 번에 묻는 표현 개수의 상한 (기본 5). 넘는 것은 묻지 않고 고친다.
DRAFT_CONFIRM_MAX=
