# 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다.

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
# 주의: 지금 코드(cfg.py)는 작성 모델과 대화 모델이 모두 이 값 하나를 읽는다.
OPENAI_MODEL=gpt-5-mini

# 정보 추출 호출의 추론 강도 (선택). minimal, low, medium, high 중 하나.
# 비워 두면 요청에 넣지 않아 모델 기본값으로 동작한다.
OPENAI_EXTRACT_REASONING_EFFORT=

# 판례 벡터 DB. data/rag_db/chroma.sqlite3 이 없을 때만 이 주소에서 내려받는다.
RAG_DB_URL=https://your-presigned-rag-db-url/chroma.sqlite3

# 판례 요약 캐시 (선택). 비워 두면 캐시 없이 동작한다.
REDIS_URL=
RAG_CASE_CACHE_TTL_SECONDS=604800
RAG_CASE_SUMMARY_VERSION=v1
